# Copy to .env (gitignored). Never commit real values.

# Weights & Biases: Weave tracing + W&B Inference (required)
WANDB_API_KEY=

# Zendesk (optional). Without these the loop runs on the mock world.
# Get the token with: uv run python -m scripts.zendesk_oauth
ZENDESK_SUBDOMAIN=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
ZENDESK_OAUTH_TOKEN=

# Force the mock world even when Zendesk is configured
# ANTIBODY_NO_ZENDESK=1

# Which agent the loop attacks when nothing else says: `builtin` (default) or the URL of an external
# agent (`http://127.0.0.1:8790`). The dashboard's agent picker overrides this per run; the CLI reads it
# directly. Setting it here also makes that agent the API's default, which means the seed-attack preview
# answers 501 (it only runs against the built-in agent) and rollback refuses runs made against the
# built-in one. Leave it unset unless every run on this machine should target that agent.
# ANTIBODY_TARGET=http://127.0.0.1:8790
