# Copy to .env (gitignored). Never commit real values.

# Weights & Biases: Weave tracing + W&B Inference (required)
WANDB_API_KEY=

# Zendesk (optional). Without these the loop runs on the mock world.
# Get the token with: uv run python -m scripts.zendesk_oauth
ZENDESK_SUBDOMAIN=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
ZENDESK_OAUTH_TOKEN=

# Force the mock world even when Zendesk is configured
# ANTIBODY_NO_ZENDESK=1
