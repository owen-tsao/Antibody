# Copy to .env (gitignored). Never commit real values.

# Weights & Biases: Weave tracing + W&B Inference (required)
WANDB_API_KEY=

# Zendesk (optional). Without these the loop runs on the mock world.
# Get the token with: uv run python -m scripts.zendesk_oauth
ZENDESK_SUBDOMAIN=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
ZENDESK_OAUTH_TOKEN=

# Force the mock world even when Zendesk is configured
# ANTIBODY_NO_ZENDESK=1

# ---- What the loop attacks -------------------------------------------------------------------------------

# Which agent the loop attacks when nothing else says: `builtin` (default), the URL of an external agent
# (`http://127.0.0.1:8792`), or `fin:<label>` for Intercom Fin. The dashboard's agent picker overrides this
# per run; the CLI reads it directly. Leave it unset unless every run on this machine should target that agent.
# ANTIBODY_TARGET=http://127.0.0.1:8792

# Where the external agent's real tools live. When set, Antibody forwards each tool call there (after the
# fault and the rules have had their say) instead of answering from the sandbox. The dashboard sets this from
# the agent row's `tools_backend`; the CLI reads it directly.
# ANTIBODY_TOOLS_BACKEND=http://127.0.0.1:8793

# Domain pack: `retail` (default) or `airline`. Decides the attacks, legit tasks, records and judge checks.
# ANTIBODY_DOMAIN=airline

# Seed for every random choice the harness makes in a run (attack family order, fault choice, record
# sampling). Unset = the clock; the value used is recorded in run.json either way.
# ANTIBODY_SEED=7

# How many times a fix must beat the new attack before it counts as fixed (pass^k). Default 2.
# ANTIBODY_GATE_FIX_SAMPLES=2

# Intercom Fin, when ANTIBODY_TARGET=fin:<label>. Bearer with write_conversations; URL defaults to Intercom's.
# INTERCOM_FIN_TOKEN=
# INTERCOM_FIN_URL=https://api.intercom.io

# ---- Dashboard API ---------------------------------------------------------------------------------------

# Shared bearer for every /api route but /api/health. Unset = open (fine on a laptop, not on a network).
# ANTIBODY_API_TOKEN=

# ---- Enforcement gateway (python -m chaos.gateway) -------------------------------------------------------

# Bearer every gateway call must carry (except /health). Unset = open.
# ANTIBODY_GATEWAY_TOKEN=
# The Authorization header your own tools expect; forwarded as-is to the backend and never logged.
# ANTIBODY_BACKEND_AUTH=Bearer <your tools token>
# ANTIBODY_GATEWAY_PORT=8766

# ---- Models ----------------------------------------------------------------------------------------------

# Models (W&B Inference ids) and the endpoint they are served from. Read once when a process starts, so
# a change here applies to the next run, never mid-run (that would invalidate the regression baseline).
# The target is deliberately small — it is the patient; the judge should be stronger than the target.
# Defaults shown; uncomment to override.
# ANTIBODY_INFERENCE_URL=https://api.inference.wandb.ai/v1
# ANTIBODY_TARGET_MODEL=meta-llama/Llama-3.1-8B-Instruct
# ANTIBODY_CHAOS_MODEL=deepseek-ai/DeepSeek-V4-Pro
# ANTIBODY_REPAIR_MODEL=deepseek-ai/DeepSeek-V4-Pro
# ANTIBODY_JUDGE_MODEL=openai/gpt-oss-120b

# ---- Dev and test knobs (not for a .env) ----------------------------------------------------------------
# Read from the process environment by the code named; the test suite sets the first three itself (tests/conftest.py).
# ANTIBODY_RUNS_DIR / ANTIBODY_HISTORY_DIR (chaos/state.py) relocate runs/ and history/; ANTIBODY_NO_DOTENV=1 (chaos/config.py)
# skips this file; ANTIBODY_NO_WEAVE=1 and ANTIBODY_NO_SCHEDULER=1 (api/attack.py, api/schedules.py) keep the API's
# background threads off; ANTIBODY_IGNORE_EXTERNAL_LOOP=1 and ANTIBODY_LOOP_CMD (api/loop_ctl.py) are for a scratch API;
# ANTIBODY_TOOLS_PORT (chaos/toolserver.py) and CHAOS_FAMILY (chaos/chaos_agent.py) pin one run. WANDB_PROJECT and
# OPENAI_API_KEY are the example agents' own (examples/agents/*/README.md), not Antibody's.
